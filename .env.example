# Neon Managed Better Auth
NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"

# Neon Postgres connection strings (Neon Console > Connect)
# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require'
DIRECT_URL='postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require'